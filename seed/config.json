      "daily": [
        { "id": "morn-reset", "label": "Morning launch", "days": [0, 1, 2, 3, 4, 5, 6] },
        { "id": "morn-walk", "label": "Morning dog walk", "days": [0, 1, 2, 3, 4, 5, 6] },
