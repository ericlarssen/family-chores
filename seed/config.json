      "id": "evening",
      "label": "Evening closedown",
      "when": "~15 min, after the girls are in bed",
      "steps": [
        "Kitchen to zero — counters clear, sink empty, dishwasher started, table wiped",
        "Living room reset — blankets folded, cushions straight, remotes and chargers home",
        "Basket lap — collect anything that lives elsewhere, redistribute it",
        "Trash and recycling out if more than three-quarters full",
        "Keys, wallet, phone to the landing spot",
        "Coffee set up, breakfast items out for morning"
      ],
      "daily": [
        { "id": "eve-reset", "label": "Evening closedown", "days": [0, 1, 2, 3, 4, 5, 6] },
        { "id": "eve-walk", "label": "Evening dog walk", "days": [0, 1, 2, 3, 4, 5, 6] },
        { "id": "eve-cook", "label": "Cook dinner", "days": [0, 2, 4] },
        { "id": "eve-dish", "label": "Kitchen reset after dinner", "days": [1, 3, 5] }
